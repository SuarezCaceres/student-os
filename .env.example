# Google OAuth 2.0 Web Client ID (Google Cloud Console -> APIs y servicios -> Credenciales)
# Necesario para habilitar "Continuar con Google" y sincronización directa con Google Calendar.
# Copia este archivo a .env.local y coloca tu Client ID real:
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# --- Nube (opcional): sincronizacion multi-dispositivo con Supabase + API NestJS ---
# Sin estas tres variables la app funciona solo con localStorage, igual que antes.
# URL del proyecto Supabase (publica)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave publishable/anon de Supabase (publica). NUNCA la service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=tu-clave-publishable
# URL base de la API (Render), sin barra final
VITE_API_URL=https://tu-api.onrender.com
