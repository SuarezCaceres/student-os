{
  "name": "@student-os/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS de StudentOS (Supabase Auth + Prisma + Postgres)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "oxlint -c .oxlintrc.json src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.0",
    "@student-os/shared": "*",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "18.6.0-beta.19",
    "jest": "^29.7.0",
    "oxlint": "^1.0.0",
    "prisma": "^6.19.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.9.0"
  }
}
