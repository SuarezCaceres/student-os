# StudentOS API - variables de entorno. Copia a `.env` (NO se versiona) y rellena.
# Nunca pegues aqui valores reales: este archivo SI se versiona.

NODE_ENV=development
# Render inyecta PORT automaticamente; solo es necesario en local.
PORT=3000

# Pooler de Supabase (Transaction mode, puerto 6543) para la app. Requiere ?pgbouncer=true
# Formato: postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
# Conexion directa (puerto 5432) para migraciones y `prisma db push`.
# Formato: postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# URL del proyecto Supabase, sin barra final: https://<ref>.supabase.co
SUPABASE_URL=
# Audiencia (`aud`) esperada en el access token. Por defecto: authenticated
SUPABASE_JWT_AUDIENCE=authenticated

# Origenes web permitidos por CORS, separados por comas, sin ruta ni barra final.
# Obligatoria en produccion. Ejemplo: https://student-os.vercel.app,http://localhost:5173
WEB_ORIGINS=http://localhost:5173

# --- Opcionales por ahora (las usa el agente GOOGLE en la Ola 3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave AES-256-GCM del refresh token (>= 32 caracteres). Generar: openssl rand -base64 32
GOOGLE_TOKEN_ENC_KEY=
